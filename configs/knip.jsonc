{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // every package exports ./* (so a page, a test and a script can reach a file by name), which makes each source file an entry; without this knip never reports an entry's unused exports
  "includeEntryExports": true,
  // what a bundler or a framework reads by name, which knip cannot see: the Preact bundle's re-exports and its type shim, and the extension's entrypoints (their default export)
  "ignoreIssues": {
    "packages/client-libs/ui-kit/scripts/preact-entry.ts": ["exports"],
    "packages/client-libs/ui-kit/types/preact.d.ts": ["exports"],
    "packages/client/extension/src/entrypoints/*.ts": ["exports"],
  },
  "workspaces": {
    ".": {
      "entry": ["skills/**/*.ts", "configs/eslint.*.mjs"],
    },
    "packages/client/extension": {
      "entry": ["src/entrypoints/**/*.ts", "scripts/*.ts"],
    },
    "packages/client-libs/ui-kit": {
      "entry": ["scripts/*.ts"],
      "ignore": ["vendor/**"],
    },
    "packages/client/web": {
      "entry": ["public/local/diff/{split,narrow,syntax}.ts", "scripts/*.ts"],
      "ignore": ["public/vendor/**"],
      // the pages import these through /assets/bridge-client/* and /assets/github-page/* URLs, which knip cannot follow: a real
      // false positive, but it also hides a genuinely unused entry, so drop one here if a page stops using it
      "ignoreDependencies": ["@once-upon-a-diff/bridge-client", "@once-upon-a-diff/github-page"],
    },
    "packages/server-libs/stories": {
      "entry": ["scripts/*.ts"],
    },
    "packages/client/panel": {
      "ignoreBinaries": ["jq"],
    },
  },
}
