{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "/assets/types.ts": ["./packages/contracts/src/types.ts"],
      "/assets/contracts/*": ["./packages/contracts/src/*"],
      "/assets/domain/*": ["./packages/domain/src/*"],
      "/assets/api-client/*": ["./packages/api-client/src/*"],
      "/assets/host-github/*": ["./packages/host-github/src/*"],
      "/assets/panel/*": ["./packages/panel/src/*"],
      "/assets/ui-kit/*": ["./packages/ui-kit/src/*"],
      "/assets/local/*": ["./packages/web/public/local/*"],
      "/assets/highlight.mjs": ["./packages/web/public/vendor/highlight.mjs"],
      "/assets/preact.mjs": ["./packages/web/public/vendor/preact.mjs"],
      "/assets/board/*": ["./packages/web/public/board/*"],
      "/assets/board.ts": ["./packages/web/public/board.ts"]
    }
  },
  "include": ["../packages/*/src", "../packages/web/public"]
}
