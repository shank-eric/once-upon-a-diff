{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "/assets/types.ts": ["./packages/domain/contracts/src/types.ts"],
      "/assets/contracts/*": ["./packages/domain/contracts/src/*"],
      "/assets/terms/*": ["./packages/domain/terms/src/*"],
      "/assets/bridge-client/*": ["./packages/client-libs/bridge-client/src/*"],
      "/assets/github-page/*": ["./packages/client/github-page/src/*"],
      "/assets/panel/*": ["./packages/client/panel/src/*"],
      "/assets/ui-kit/*": ["./packages/client-libs/ui-kit/src/*"],
      "/assets/local/*": ["./packages/client/web/public/local/*"],
      "/assets/highlight.mjs": ["./packages/client/web/public/vendor/highlight.mjs"],
      "/assets/preact.mjs": ["./packages/client/web/public/vendor/preact.mjs"],
      "/assets/board/*": ["./packages/client/web/public/board/*"],
      "/assets/board.ts": ["./packages/client/web/public/board.ts"]
    }
  },
  "include": ["../packages/*/*/src", "../packages/client/web/public"]
}
