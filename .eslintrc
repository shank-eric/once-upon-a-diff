{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "webextensions": true
  },
  "extends": [
    "prettier"
  ],
  "plugins": [
    "eslint-plugin-import"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": ["bridge/**/*.mjs", "test/**/*.mjs", "scripts/**/*.mjs"],
      "env": { "node": true, "browser": false }
    },
    {
      "files": ["bridge/public/*.js"],
      "env": { "browser": true, "webextensions": false }
    }
  ],
  "rules": {
    "consistent-return": "off",
    "import/extensions": [
      "error",
      {
        "js": "always",
        "mjs": "always"
      }
    ],
    "max-len": [
      "warn",
      250
    ],
    "no-param-reassign": "off",
    "no-undef": "error",
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    "quotes": ["error", "single", { "avoidEscape": true, "allowTemplateLiterals": true }],
    "radix": [
      "error",
      "as-needed"
    ]
  }
}
