{
  "name": "diff-story-mode",
  "version": "0.1.0",
  "private": true,
  "description": "A code-review story in a side panel on top of a diff: a Chrome extension for GitHub PRs, plus a local bridge that also serves local commits",
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "diff-story": "bridge/bin/diff-story.mjs"
  },
  "scripts": {
    "bridge": "node bridge/bin/diff-story.mjs serve",
    "icons": "node scripts/make-icons.mjs",
    "vendor": "node scripts/vendor-hljs.mjs",
    "js:lint": "eslint .",
    "js:lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "yarn js:lint && yarn format:check",
    "test": "node --test test/*.test.mjs",
    "test:extension": "node test/extension/load-test.mjs",
    "test:expand": "node test/extension/expand-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.13.0",
    "highlight.js": "11.11.1",
    "playwright-core": "1.64.0",
    "prettier": "3.9.9"
  }
}
