{
  "name": "once-upon-a-diff-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "A code-review story in a side panel on top of a diff: a Chrome extension for GitHub PRs, plus a local bridge that also serves local commits",
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bridge": "yarn workspace once-upon-a-diff serve",
    "dev": "yarn workspace @once-upon-a-diff/extension dev",
    "build": "yarn workspace @once-upon-a-diff/extension build",
    "zip": "yarn workspace @once-upon-a-diff/extension zip",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:fix": "eslint . --fix",
    "lint:sh": "shellcheck skills/once-upon/bin/*.sh",
    "typecheck": "yarn workspaces foreach --all --exclude once-upon-a-diff-workspace -v run typecheck && tsc -p tsconfig.json",
    "lint-staged": "./node_modules/.bin/lint-staged",
    "format": "prettier --cache --cache-location=.prettiercache --write .",
    "format:check": "prettier --cache --cache-location=.prettiercache --check .",
    "postinstall": "husky",
    "test": "yarn workspaces foreach --all --exclude once-upon-a-diff-workspace -v run test",
    "test:extension": "yarn workspace @once-upon-a-diff/extension test:extension",
    "test:expand": "yarn workspace @once-upon-a-diff/extension test:expand"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "shellcheck": "3.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --no-warn-ignored",
      "prettier --check"
    ]
  }
}
