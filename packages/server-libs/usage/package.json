{
  "name": "@once-upon-a-diff/usage",
  "version": "0.1.0",
  "private": true,
  "description": "Once Upon a Diff's usage capture (ADR-18): dev instrumentation the shell, the CLI and the HTTP app load, beside the engine, with its own adapters folder",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "node ../foundation/src/node-version.mjs && node --test --test-timeout=60000 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@once-upon-a-diff/adapters": "workspace:*",
    "@once-upon-a-diff/contracts": "workspace:*",
    "@once-upon-a-diff/foundation": "workspace:*",
    "@once-upon-a-diff/terms": "workspace:*"
  },
  "devDependencies": {
    "@once-upon-a-diff/test-kit": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
