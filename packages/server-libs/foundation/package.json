{
  "name": "@once-upon-a-diff/foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Once Upon a Diff's foundation: the settings, the repo list, ids, errors and input checks, over the adapters",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "node src/node-version.mjs && node --test --test-timeout=60000 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@once-upon-a-diff/adapters": "workspace:*",
    "@once-upon-a-diff/contracts": "workspace:*",
    "@once-upon-a-diff/terms": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
