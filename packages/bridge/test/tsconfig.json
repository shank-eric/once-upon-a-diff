{
  "extends": "../../../configs/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "paths": {
      "/assets/preact.mjs": ["../../web/public/types/preact.d.ts"],
      "/assets/local/*": ["../../web/public/local/*"],
      "/assets/types.ts": ["../../contracts/src/types.ts"],
      "/assets/contracts/*": ["../../contracts/src/*"],
      "/assets/domain/*": ["../../domain/src/*"],
      "/assets/bridge-client/*": ["../../bridge-client/src/*"],
      "/assets/github-page/*": ["../../github-page/src/*"]
    }
  },
  "include": [".", "../../panel/types"],
  "exclude": ["browser"]
}
