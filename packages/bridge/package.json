{
  "name": "once-upon-a-diff",
  "version": "0.1.0",
  "private": true,
  "description": "Once Upon a Diff's local bridge and its CLI (once-upon): serves stories to the extension and the local page, and takes requests for Claude sessions",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "once-upon": "bin/once-upon.mjs"
  },
  "exports": {
    "./*": "./src/*.ts",
    "./test/*": "./test/*.ts"
  },
  "scripts": {
    "serve": "node bin/once-upon.mjs serve",
    "test": "node bin/node-version.mjs && node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@once-upon-a-diff/host-github": "workspace:*",
    "@once-upon-a-diff/panel": "workspace:*",
    "@once-upon-a-diff/protocol": "workspace:*",
    "@once-upon-a-diff/web": "workspace:*"
  },
  "devDependencies": {
    "@once-upon-a-diff/test-kit": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
