{
  "name": "@once-upon-a-diff/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Once Upon a Diff's shared UI pieces for the board, the local page, the panel and the extension: the small DOM and clipboard helpers, Start listening and the generic Preact components",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "node ../bridge/bin/node-version.mjs && node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@once-upon-a-diff/protocol": "workspace:*"
  },
  "devDependencies": {
    "@once-upon-a-diff/test-kit": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
