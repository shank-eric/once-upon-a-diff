{
  "name": "@once-upon-a-diff/github-page",
  "version": "0.1.0",
  "private": true,
  "description": "Once Upon a Diff's GitHub host adapter: reads GitHub's diff page and URLs for the panel, so a change in GitHub's markup lands in one package",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "node ../../server-libs/foundation/src/node-version.mjs && node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@once-upon-a-diff/panel": "workspace:*",
    "@once-upon-a-diff/terms": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
