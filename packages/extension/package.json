{
  "name": "@once-upon-a-diff/extension",
  "version": "0.1.0",
  "private": true,
  "description": "The Once Upon a Diff Chrome extension: the story panel on GitHub pull requests",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "ONCE_UPON_STORE=1 wxt zip",
    "icons": "node ../foundation/src/node-version.mjs && node scripts/make-icons.ts",
    "postinstall": "wxt prepare",
    "test": "node ../foundation/src/node-version.mjs && node --test --test-timeout=60000 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@once-upon-a-diff/bridge-client": "workspace:*",
    "@once-upon-a-diff/contracts": "workspace:*",
    "@once-upon-a-diff/domain": "workspace:*",
    "@once-upon-a-diff/github-page": "workspace:*",
    "@once-upon-a-diff/panel": "workspace:*",
    "@once-upon-a-diff/ui-kit": "workspace:*"
  },
  "devDependencies": {
    "@once-upon-a-diff/test-kit": "workspace:*",
    "@types/chrome": "0.3.4",
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wxt": "0.21.4"
  }
}
