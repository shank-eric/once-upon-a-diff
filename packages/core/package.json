{
  "name": "@once-upon-a-diff/core",
  "version": "0.1.0",
  "private": true,
  "description": "Once Upon a Diff's core: what the reviewer does with the state and the stories: the features (listeners, publishing, review, sessions) and, over them, the bridge's own start-up and doctor. The HTTP app and the CLI sit on top",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "node ../foundation/src/node-version.mjs && node --test --test-timeout=60000 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@once-upon-a-diff/adapters": "workspace:*",
    "@once-upon-a-diff/contracts": "workspace:*",
    "@once-upon-a-diff/domain": "workspace:*",
    "@once-upon-a-diff/foundation": "workspace:*",
    "@once-upon-a-diff/state": "workspace:*",
    "@once-upon-a-diff/stories": "workspace:*"
  },
  "devDependencies": {
    "@once-upon-a-diff/test-kit": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
