{
  "name": "@once-upon-a-diff/state",
  "version": "0.1.0",
  "private": true,
  "description": "Once Upon a Diff's state: what is stored (agents, GitHub's facts, listeners, page links, worktrees) and the queues over it (requests, backlog), in two tiers, over the stories",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*": "./src/*.ts",
    "./test/*": "./test/*.ts"
  },
  "scripts": {
    "test": "node ../foundation/src/node-version.mjs && node --test --test-timeout=60000 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@once-upon-a-diff/adapters": "workspace:*",
    "@once-upon-a-diff/contracts": "workspace:*",
    "@once-upon-a-diff/domain": "workspace:*",
    "@once-upon-a-diff/foundation": "workspace:*",
    "@once-upon-a-diff/stories": "workspace:*"
  },
  "devDependencies": {
    "@once-upon-a-diff/test-kit": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
