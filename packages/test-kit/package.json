{
  "name": "@once-upon-a-diff/test-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Once Upon a Diff's dev-only test helpers: temp files, git repos, story fixtures and a DOM for the pages' tests. Tests import it; nothing that ships does",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "node ../core/src/foundation/node-version.mjs && node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "linkedom": "0.18.14"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
