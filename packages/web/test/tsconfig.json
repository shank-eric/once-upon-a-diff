{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "paths": {
      "/assets/preact.mjs": ["../public/types/preact.d.ts"],
      "/assets/local/*": ["../public/local/*"],
      "/assets/board/*": ["../public/board/*"],
      "/assets/types.ts": ["../../protocol/src/types.ts"],
      "/assets/protocol/*": ["../../protocol/src/*"],
      "/assets/host-github/*": ["../../host-github/src/*"],
      "/assets/panel/*": ["../../panel/src/*"],
      "/assets/highlight.mjs": ["../public/types/highlight.d.ts"],
      "/assets/*": ["../public/*"]
    }
  },
  "include": [".", "../../panel/types"]
}
