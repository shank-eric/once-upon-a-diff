{
  "extends": "../../../configs/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "paths": {
      "/assets/preact.mjs": ["../public/types/preact.d.ts"],
      "/assets/local/*": ["../public/local/*"],
      "/assets/board/*": ["../public/board/*"],
      "/assets/types.ts": ["../../contracts/src/types.ts"],
      "/assets/contracts/*": ["../../contracts/src/*"],
      "/assets/domain/*": ["../../domain/src/*"],
      "/assets/bridge-client/*": ["../../bridge-client/src/*"],
      "/assets/github-page/*": ["../../github-page/src/*"],
      "/assets/panel/*": ["../../panel/src/*"],
      "/assets/ui-kit/*": ["../../ui-kit/src/*"],
      "/assets/highlight.mjs": ["../public/types/highlight.d.ts"],
      "/assets/*": ["../public/*"]
    }
  },
  "include": [".", "../../panel/types"]
}
