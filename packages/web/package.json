{
  "name": "@once-upon-a-diff/web",
  "version": "0.1.0",
  "private": true,
  "description": "Once Upon a Diff's pages: the agent board and the local story page, served by the bridge",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@once-upon-a-diff/bridge-client": "workspace:*",
    "@once-upon-a-diff/contracts": "workspace:*",
    "@once-upon-a-diff/domain": "workspace:*",
    "@once-upon-a-diff/github-page": "workspace:*",
    "@once-upon-a-diff/panel": "workspace:*",
    "@once-upon-a-diff/ui-kit": "workspace:*"
  },
  "devDependencies": {
    "@once-upon-a-diff/test-kit": "workspace:*",
    "@types/node": "24.19.1",
    "highlight.js": "11.11.1",
    "htm": "3.1.1",
    "preact": "10.29.8",
    "rolldown": "1.2.15",
    "typescript": "5.9.3"
  },
  "exports": {
    "./public/*": "./public/*"
  },
  "scripts": {
    "vendor": "node ../core/src/foundation/node-version.mjs && node scripts/vendor-hljs.ts && node scripts/vendor-preact.ts",
    "test": "node ../core/src/foundation/node-version.mjs && node --test --test-timeout=60000 test/*.test.ts",
    "typecheck": "tsc -p public/tsconfig.json && tsc -p test/tsconfig.json"
  }
}
