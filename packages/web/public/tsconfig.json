{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "/assets/types.ts": ["../../protocol/src/types.ts"],
      "/assets/protocol/*": ["../../protocol/src/*"],
      "/assets/api-client/*": ["../../api-client/src/*"],
      "/assets/host-github/*": ["../../host-github/src/*"],
      "/assets/panel/*": ["../../panel/src/*"],
      "/assets/ui/*": ["../../ui/src/*"],
      "/assets/local/*": ["./local/*"],
      "/assets/highlight.mjs": ["./types/highlight.d.ts"],
      "/assets/preact.mjs": ["./types/preact.d.ts"],
      "/assets/*": ["./*"]
    }
  },
  "include": [".", "../../panel/types"],
  "exclude": ["vendor"]
}
