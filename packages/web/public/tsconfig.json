{
  "extends": "../../../configs/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "/assets/types.ts": ["../../contracts/src/types.ts"],
      "/assets/contracts/*": ["../../contracts/src/*"],
      "/assets/domain/*": ["../../domain/src/*"],
      "/assets/api-client/*": ["../../api-client/src/*"],
      "/assets/github-page/*": ["../../github-page/src/*"],
      "/assets/panel/*": ["../../panel/src/*"],
      "/assets/ui-kit/*": ["../../ui-kit/src/*"],
      "/assets/local/*": ["./local/*"],
      "/assets/highlight.mjs": ["./types/highlight.d.ts"],
      "/assets/preact.mjs": ["./types/preact.d.ts"],
      "/assets/*": ["./*"]
    }
  },
  "include": [".", "../../panel/types"],
  "exclude": ["vendor"]
}
