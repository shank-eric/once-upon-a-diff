{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "chrome"
    ],
    "paths": {
      "/assets/overlay.js": [
        "./src/shared/overlay.js"
      ],
      "/assets/util/*": [
        "./src/shared/util/*"
      ],
      "/assets/panel/*": [
        "./src/shared/panel/*"
      ],
      "/assets/local/*": [
        "./src/bridge/public/local/*"
      ],
      "/assets/highlight.mjs": [
        "./types/highlight.d.ts"
      ],
      "/assets/*": [
        "./src/bridge/public/*"
      ]
    }
  },
  "include": [
    "src/extension/**/*.js",
    "src/shared/**/*.js",
    "src/bridge/public/**/*.js",
    "types/*.d.ts"
  ],
  "exclude": [
    "src/bridge/public/vendor",
    "src/extension/entrypoints"
  ]
}
