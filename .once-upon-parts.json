{
  "version": 1,
  "groups": [
    "Bridge",
    "Client",
    "Shared",
    "Repo"
  ],
  "parts": [
    {
      "id": "server",
      "name": "Server",
      "group": "Bridge",
      "paths": [
        "packages/server/src/"
      ],
      "note": "The HTTP app and its routes"
    },
    {
      "id": "cli",
      "name": "CLI",
      "group": "Bridge",
      "paths": [
        "packages/cli/src/",
        "packages/bridge/bin/",
        "packages/bridge/instrumentation/"
      ],
      "note": "The once-upon command"
    },
    {
      "id": "stories",
      "name": "Story pipeline",
      "group": "Bridge",
      "paths": [
        "packages/stories/src/",
        "packages/stories/scripts/",
        "packages/core/src/features/publishing/",
        "skills/once-upon/bin/"
      ],
      "note": "Reading, placing, publishing and rebuilding stories"
    },
    {
      "id": "review-inbox",
      "name": "Review and inbox",
      "group": "Bridge",
      "paths": [
        "packages/core/src/features/review/",
        "packages/state/src/records/github/",
        "packages/state/src/queues/requests/"
      ],
      "note": "GitHub review sync, drafts, and the panel requests sessions answer"
    },
    {
      "id": "board-services",
      "name": "Board services",
      "group": "Bridge",
      "paths": [
        "packages/board/src/",
        "packages/state/src/queues/backlog/",
        "packages/state/src/records/agents/",
        "packages/foundation/src/input.ts",
        "packages/state/src/records/worktrees/",
        "packages/usage/src/"
      ],
      "note": "What the board shows: cards, agents, worktrees, usage"
    },
    {
      "id": "sessions-config",
      "name": "Sessions and config",
      "group": "Bridge",
      "paths": [
        "packages/core/src/features/sessions/",
        "packages/state/src/records/listeners/",
        "packages/core/src/features/listeners/",
        "packages/core/src/features/heavy/",
        "packages/foundation/src/",
        "packages/core/src/orchestration/bridge/",
        "packages/state/src/records/page-links/",
        "packages/board/src/voice.ts"
      ],
      "note": "Claude sessions, listeners, settings and the rest of the services"
    },
    {
      "id": "adapters",
      "name": "Adapters",
      "group": "Bridge",
      "paths": [
        "packages/adapters/src/"
      ],
      "note": "Every side effect: programs, files, network"
    },
    {
      "id": "panel",
      "name": "Panel",
      "group": "Client",
      "paths": [
        "packages/panel/"
      ],
      "note": "The story panel"
    },
    {
      "id": "host",
      "name": "Host adapter",
      "group": "Client",
      "paths": [
        "packages/github-page/"
      ],
      "note": "GitHub diff-page reader and URL routing"
    },
    {
      "id": "pages",
      "name": "Pages",
      "group": "Client",
      "paths": [
        "packages/web/"
      ],
      "note": "The board and local story pages"
    },
    {
      "id": "extension",
      "name": "Extension",
      "group": "Client",
      "paths": [
        "packages/extension/"
      ],
      "note": "The Chrome extension"
    },
    {
      "id": "ui",
      "name": "UI",
      "group": "Client",
      "paths": [
        "packages/ui-kit/"
      ],
      "note": "Shared components and helpers"
    },
    {
      "id": "bridge-client",
      "name": "API client",
      "group": "Client",
      "paths": [
        "packages/bridge-client/"
      ],
      "note": "The typed client and the poll"
    },
    {
      "id": "contracts",
      "name": "Contracts",
      "group": "Shared",
      "paths": [
        "packages/contracts/"
      ],
      "note": "Wire types, routes and schemas"
    },
    {
      "id": "domain",
      "name": "Domain",
      "group": "Shared",
      "paths": [
        "packages/domain/"
      ],
      "note": "Pure rules that import nothing"
    },
    {
      "id": "skills",
      "name": "Skills",
      "group": "Repo",
      "paths": [
        "skills/"
      ],
      "note": "The once-upon, once-upon-listen and once-upon-editor skills"
    },
    {
      "id": "scripts-docs",
      "name": "Scripts and docs",
      "group": "Repo",
      "paths": [
        "scripts/",
        "extras/",
        "docs/",
        "README.md",
        "docs/GETTING-STARTED.md",
        ".github/CONTRIBUTING.md",
        "AGENTS.md",
        "LICENSE"
      ],
      "note": "Deploy, beat, heavy-lock and cleanup scripts, optional extras, documents"
    },
    {
      "id": "tests",
      "name": "Tests",
      "group": "Repo",
      "paths": [
        "packages/bridge/test/",
        "packages/core/test/",
        "packages/cli/test/",
        "packages/server/test/",
        "packages/panel/test/",
        "packages/ui-kit/test/",
        "packages/contracts/test/",
        "packages/domain/test/",
        "packages/web/test/",
        "packages/extension/test/",
        "packages/github-page/test/",
        "packages/bridge-client/test/",
        "packages/test-kit/test/",
        "packages/test-kit/",
        "packages/adapters/test/",
        "packages/foundation/test/",
        "packages/usage/test/",
        "packages/stories/test/",
        "packages/state/test/",
        "packages/board/test/"
      ],
      "note": "Every package's tests and the shared test helpers"
    },
    {
      "id": "config",
      "name": "Config",
      "group": "Repo",
      "paths": [
        ".once-upon-parts.json",
        "packages/bridge/package.json",
        "packages/bridge/tsconfig.json",
        "packages/core/package.json",
        "packages/core/tsconfig.json",
        "packages/server/package.json",
        "packages/server/tsconfig.json",
        "packages/cli/package.json",
        "packages/cli/tsconfig.json",
        "package.json",
        "tsconfig.json",
        "eslint.config.mjs",
        "configs/",
        "yarn.lock",
        ".yarnrc.yml",
        ".yarn/",
        ".github/",
        ".husky/",
        ".gitignore",
        ".nvmrc",
        ".prettierignore",
        ".prettierrc.json",
        ".shellcheckrc",
        "packages/adapters/package.json",
        "packages/adapters/tsconfig.json",
        "packages/foundation/package.json",
        "packages/foundation/tsconfig.json",
        "packages/usage/package.json",
        "packages/usage/tsconfig.json",
        "packages/stories/package.json",
        "packages/stories/tsconfig.json",
        "packages/state/package.json",
        "packages/state/tsconfig.json",
        "packages/board/package.json",
        "packages/board/tsconfig.json"
      ],
      "note": "Build, lint and CI setup"
    }
  ]
}
